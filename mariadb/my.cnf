[mariadb]
# --- Bellek Yönetimi (RAM'inizin %60'ı kadar ayarlayın) ---
innodb_buffer_pool_size         = 6G   # Örn: 10GB RAM ayrıldıysa
innodb_buffer_pool_instances    = 6    # Her 1GB için 1 adet (Çakışmayı önler)

# --- Çoklu Site İçin Bağlantı Ayarları ---
max_connections                 = 500  # Site sayısı arttıkça bu değer yükselmeli
max_user_connections            = 450  # Root'un dışarıda kalmaması için bir pay bırakın
wait_timeout                    = 60   # Uzun süre yanıt vermeyen bağlantıları kesin
interactive_timeout             = 60

# --- WordPress Sorgu Optimizasyonu ---
# Sorgu önbelleğini KAPATIN. Çoklu sitelerde bu özellik darboğaz yaratır.
query_cache_type                = 0
query_cache_size                = 0

# --- InnoDB Disk ve Yazma Performansı ---
innodb_log_file_size            = 512M # Yazma yoğunluğu fazlaysa 1G yapın
innodb_log_buffer_size          = 32M
innodb_flush_log_at_trx_commit  = 2    # Çoklu sitelerde performansı 5 kat artırır
innodb_flush_method             = O_DIRECT
innodb_io_capacity              = 2000 # SSD kullanıyorsanız bu değeri artırın

# --- Tablo Yönetimi (Çok önemli) ---
# WordPress'in binlerce tablosu olacağı için bu değerleri yüksek tutun
table_open_cache                = 10000
table_definition_cache          = 5000
open_files_limit                = 65535

# --- Diğer Kritik Ayarlar ---
skip_name_resolve               = 1    # DNS aramalarını kapatır, hızı artırır
max_allowed_packet              = 64M  # Büyük veritabanı importları için


# Hata loglarını devre dışı bırakır (veya /dev/null'a yönlendirir)
log_error = /dev/null

# Genel sorgu loglarını kapatır (Zaten varsayılan kapalıdır ama garantiye alın)
general_log = 0

# Yavaş sorgu loglarını kapatır
slow_query_log = 0

# Binlog (Binary Log) Kapatma: 
# Eğer replikasyon (ikincil sunucu) kullanmıyorsanız binlogları kapatmak 
# disk yazma yükünü devasa oranda azaltır.
skip_log_bin

# InnoDB tarafındaki log üretimini de minimize edelim
innodb_stats_on_metadata = 0

